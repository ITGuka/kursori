Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # არსებული ფაილები (assets, uploads) პირდაპირ; დანარჩენი — index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # CSP: სკრიპტებს/სტილებს არ ზღუდავს (CDN-ები, ანალიტიკის კოდი პარამეტრებიდან), მაგრამ კრძალავს
    # საიტის სხვის iframe-ში ჩასმას, <object>/<embed>-ს, <base>-ის შეცვლას და ფორმების სხვა დომენზე გაგზავნას.
    # ასევე ჩაანაცვლებს მშობელი C:\laragon\www\.htaccess-ის (სხვა პროექტის) CSP-ს localhost/WEBDEV/-ზე.
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # სტატიკური ფაილები: CSS/JS-ს ვერსია URL-შია (?v=ცვლილების დრო), ატვირთვებს — შემთხვევითი სახელი,
    # ამიტომ ბრაუზერში 1 წელი ინახება. თემის სურათის (assets/front/img) შეცვლისას — ახალი სახელით.
    <FilesMatch "\.(css|js|woff2?|ttf|svg|ico|png|jpe?g|gif|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
