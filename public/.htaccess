Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # არსებული ფაილები (assets, uploads) პირდაპირ; დანარჩენი — index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # CSP: სკრიპტებს/სტილებს არ ზღუდავს (CDN-ები, ანალიტიკის კოდი პარამეტრებიდან), მაგრამ კრძალავს
    # საიტის სხვის iframe-ში ჩასმას, <object>/<embed>-ს, <base>-ის შეცვლას და ფორმების სხვა დომენზე გაგზავნას.
    # ასევე ჩაანაცვლებს მშობელი C:\laragon\www\.htaccess-ის (სხვა პროექტის) CSP-ს localhost/WEBDEV/-ზე.
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # დიზაინების შაბლონები (ადმინიდან ატვირთული HTML/JS): CSP sandbox — პირდაპირ გახსნისასაც უცხო origin-ზე
    # მუშაობს (ჩვენი cookie/DOM მიუწვდომელია), მხოლოდ ჩვენი საიტის iframe-ში ჩაისმება. sandbox-იან გვერდს origin
    # „null“ აქვს — შრიფტები/მოდულები CORS-ით იტვირთება, ამიტომ Access-Control-Allow-Origin: *.
    <If "%{REQUEST_URI} =~ m#/uploads/designs/#">
        Header always set Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-modals; frame-ancestors 'self'; object-src 'none'"
        Header always set Access-Control-Allow-Origin "*"
    </If>

    # სტატიკური ფაილები: ვერსიიანი (?v=ცვლილების დრო, asset()) და ატვირთვები (შემთხვევითი სახელი) — 1 წელი,
    # immutable; დანარჩენი (CSS-იდან მოთხოვნილი თემის სურათები, შრიფტები, favicon) — 1 კვირა.
    <FilesMatch "\.(css|js|woff2?|ttf|svg|ico|png|jpe?g|gif|webp)$">
        Header set Cache-Control "public, max-age=604800"
        <If "%{QUERY_STRING} =~ /(^|&)v=/ || %{REQUEST_URI} =~ m#/uploads/#">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
