# სარეზერვო გზა http://localhost/KURSORI/-ისთვის: ყველაფერი public/-ში გადადის,
# ასე core/, app/, config/, storage/, .env ბრაუზერიდან მიუწვდომელია.
# ძირითადი მისამართი: http://kursori.test (vhost → public/)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
