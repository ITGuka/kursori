# სარეზერვო გზა http://localhost/WEBDEV/-ისთვის: ყველაფერი public/-ში გადადის,
# ასე core/, app/, config/, storage/, .env ბრაუზერიდან მიუწვდომელია.
# ძირითადი მისამართი: http://webdev.test (vhost → public/)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
