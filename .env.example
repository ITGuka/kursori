# დააკოპირეთ .env სახელით. .env git-ში არ ინახება.
APP_NAME=WEBDEV
# local | production
APP_ENV=local
APP_DEBUG=true
APP_URL=http://webdev.test
# საიდუმლოების დაშიფვრის გასაღები (SMTP პაროლი): php bin/console key:generate
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=webdev_db
DB_USERNAME=root
DB_PASSWORD=

# პირველი ადმინი (php bin/console db:seed); შემდეგ შეიძლება წაიშალოს
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@webdev.test
ADMIN_PASSWORD=
